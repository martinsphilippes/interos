# Copie para .env.local e preencha com os valores do console do Firebase
# (Configurações do projeto > Seus apps > Web app > SDK setup and configuration).
# Todas as variáveis NEXT_PUBLIC_* são embutidas no bundle do navegador em tempo de build.
# Cadastre as mesmas chaves na Vercel (Settings > Environment Variables) para Production e Preview.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional. Só preencha se Google Analytics estiver ativado no projeto Firebase.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Defina como "true" para apontar o SDK para os emuladores locais (firebase emulators:start).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Somente servidor (nunca use o prefixo NEXT_PUBLIC_) ---
# Token do webhook de leads (POST /api/webhooks/leads, header "x-interos-token").
# Em produção, sem esta variável o webhook responde 503. Em desenvolvimento, aceita qualquer chamada.
LEADS_WEBHOOK_TOKEN=
# Opcional. Chave do Google Maps (geocode/rotas das visitas). Sem ela, src/server/sales/maps.ts usa o mock.
GOOGLE_MAPS_API_KEY=

# Ambiente de demonstração: "true" mostra na tela de login a dica com as credenciais do usuário demo
# (hercules@intercert.com.br) e o botão para preenchê-las. Deixe vazio/false em produção.
NEXT_PUBLIC_DEMO_MODE=false
