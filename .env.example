# Copie para .env.local e preencha. Cadastre as mesmas chaves na Vercel (Settings > Environment Variables) para
# Production e Preview. As variáveis NEXT_PUBLIC_* são embutidas no bundle do navegador em tempo de build.

# Supabase (painel do projeto → Project Settings → API). A chave publicável é pública por design: o navegador só usa
# o Supabase Auth (login, redefinição de senha, Microsoft); o schema de dados não é exposto pela Data API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do sistema (ex.: https://interos.intercert.com.br), sem barra no fim. Usado para montar links
# absolutos enviados ao cliente: Portal do Cliente (/portal/<token>, inclusive {linkPortal} das mensagens de cobrança
# e da régua) e pesquisa CSAT. Sem ela, usa o domínio de produção da Vercel ou o host da requisição; fora de requisição
# (varredura sem cabeçalhos) nenhum link de portal é gerado. Não é segredo.
NEXT_PUBLIC_APP_URL=

# --- Somente servidor (nunca use o prefixo NEXT_PUBLIC_) ---
# Organização usada pelo Admin SDK em todas as consultas (multiempresa). Opcional: sem ela vale a organização
# única "intercert" (ORGANIZATION_ID em src/domain/constants.ts). Só mude em um ambiente dedicado a outra empresa.
INTEROS_ORGANIZATION_ID=
# Conexão do servidor com o banco: papel `interos_app` (criado pela migration; senha definida fora do repositório).
# Produção/Preview (Vercel): pooler do Supabase em modo transação, porta 6543:
#   postgresql://interos_app.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Local: postgres://interos_app:local@127.0.0.1:5432/interos (ver scripts/db-local.sh). Nunca commite.
DATABASE_URL=
# Opcional: conexões por instância de função (padrão 5).
DATABASE_POOL_MAX=
# Assina o cookie de sessão do INTEROS e os tokens do CSAT público (chaves derivadas separadas). Obrigatória em
# produção: troque-a para derrubar todas as sessões abertas. Gere com `openssl rand -base64 48`.
SESSION_COOKIE_SECRET=
# Senha dos usuários de demonstração criados pelo seed fora do banco local (mínimo 10 caracteres).
# No banco local o seed usa "interos123". Em produção fica só no segredo do GitHub Actions.
INTEROS_SEED_PASSWORD=
# Token do webhook de leads (POST /api/webhooks/leads, header "x-interos-token").
# Em produção, sem esta variável o webhook responde 503. Em desenvolvimento, aceita qualquer chamada.
LEADS_WEBHOOK_TOKEN=

# --- Integrações externas (estado em /admin/integracoes; registro em src/server/integrations/status.ts) ---
# "Conectado" = variáveis presentes + adaptador implementado. Sem elas o sistema usa o fallback manual
# (wa.me, tel:, mailto:, mapa por URL, assinatura/pagamento registrados com evidência). Nunca use NEXT_PUBLIC_.

# WhatsApp Business (Meta Cloud API): envio de mensagens (cobrança, régua de cobrança, Caixa de Entrada, Suporte).
# Política de canais: WhatsApp é o canal PRINCIPAL com o cliente; e-mail é COMPLEMENTAR (ver docs/contexto-negocio.md).
# Fora da janela de 24 h a Meta exige template aprovado (ainda não implementado: só texto livre).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook de entrada /api/webhooks/whatsapp: token do handshake GET da Meta; App Secret do app no Meta for Developers
# (valida o header X-Hub-Signature-256 = HMAC-SHA256 do corpo, enviado pela Meta em toda chamada — obrigatório para
# receber mensagens e statuses reais); WHATSAPP_WEBHOOK_TOKEN é a alternativa por header x-interos-token (integradores/testes).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_TOKEN=

# Telefonia VoIP/PABX (click-to-call e gravação). Adaptador ainda não implementado: com a chave, o estado fica "Verificar".
VOIP_PROVIDER=
VOIP_PROVIDER_API_KEY=

# E-mail transacional. Resend (implementado): RESEND_API_KEY + EMAIL_FROM.
# SMTP (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD + EMAIL_FROM) fica "Verificar" até existir adaptador SMTP.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Assinatura digital (Clicksign/DocuSign). Adaptador ainda não implementado: documento gerado no INTEROS e assinatura registrada com evidência.
SIGNATURE_PROVIDER=
SIGNATURE_PROVIDER_API_KEY=
SIGNATURE_WEBHOOK_TOKEN=

# Cobrança (Asaas/Iugu/banco). Adaptador ainda não implementado (contrato em src/server/integrations/billing-provider.ts):
# sem ele, boletos são emitidos no banco/ERP e REGISTRADOS na cobrança ("Registrar boleto"), a baixa é manual com
# comprovante, a varredura "conciliacao_bancaria" fica "ignorada: provedor não conectado" e o webhook responde 503.
# Com o adaptador: emissão em generateBillings, cancelamento espelhado, conciliação diária e baixa via webhook com
# deduplicação (payment_events). BILLING_WEBHOOK_TOKEN protege POST /api/webhooks/cobranca (401 sem token; 503 sem provedor).
BILLING_PROVIDER=
BILLING_PROVIDER_API_KEY=
BILLING_WEBHOOK_TOKEN=

# Google Maps (somente servidor): Geocoding API + Distance Matrix API nas visitas. Sem ela, distância estimada pela cidade.
GOOGLE_MAPS_API_KEY=

# IA (Anthropic): sugestões dos agentes de automação. INTEROS_AI_MODEL é opcional (padrão claude-sonnet-5).
ANTHROPIC_API_KEY=
INTEROS_AI_MODEL=

# Microsoft SSO: não usa variável aqui; habilite o provedor Azure no painel do Supabase → Authentication → Providers
# (Client ID, segredo e tenant do app no Entra ID; redirect URI <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback).

# Fase de testes: "true" mostra na tela de login o "Acesso rápido", com um card por usuário ativo que entra com
# um clique (sessão criada pelo servidor, sem senha). Qualquer visitante do login entra como qualquer
# usuário: desligue (false) e republique antes de colocar dados reais. Lida no build (NEXT_PUBLIC_).
NEXT_PUBLIC_DEMO_MODE=false
