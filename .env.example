# Copie para .env.local e preencha com os valores do console do Firebase
# (Configurações do projeto > Seus apps > Web app > SDK setup and configuration).
# Todas as variáveis NEXT_PUBLIC_* são embutidas no bundle do navegador em tempo de build.
# Cadastre as mesmas chaves na Vercel (Settings > Environment Variables) para Production e Preview.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional. Só preencha se Google Analytics estiver ativado no projeto Firebase.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Defina como "true" para apontar o SDK para os emuladores locais (firebase emulators:start).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Somente servidor (nunca use o prefixo NEXT_PUBLIC_) ---
# Token do webhook de leads (POST /api/webhooks/leads, header "x-interos-token").
# Em produção, sem esta variável o webhook responde 503. Em desenvolvimento, aceita qualquer chamada.
LEADS_WEBHOOK_TOKEN=

# --- Integrações externas (estado em /admin/integracoes; registro em src/server/integrations/status.ts) ---
# "Conectado" = variáveis presentes + adaptador implementado. Sem elas o sistema usa o fallback manual
# (wa.me, tel:, mailto:, mapa por URL, assinatura/pagamento registrados com evidência). Nunca use NEXT_PUBLIC_.

# WhatsApp Business (Meta Cloud API): envio de mensagens (cobrança, Caixa de Entrada, Suporte).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook de entrada /api/webhooks/whatsapp: token do handshake GET da Meta e token do header x-interos-token.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_TOKEN=

# Telefonia VoIP/PABX (click-to-call e gravação). Adaptador ainda não implementado: com a chave, o estado fica "Verificar".
VOIP_PROVIDER=
VOIP_PROVIDER_API_KEY=

# E-mail transacional. Resend (implementado): RESEND_API_KEY + EMAIL_FROM.
# SMTP (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD + EMAIL_FROM) fica "Verificar" até existir adaptador SMTP.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Assinatura digital (Clicksign/DocuSign). Adaptador ainda não implementado: documento gerado no INTEROS e assinatura registrada com evidência.
SIGNATURE_PROVIDER=
SIGNATURE_PROVIDER_API_KEY=
SIGNATURE_WEBHOOK_TOKEN=

# Cobrança (Asaas/Iugu). Adaptador ainda não implementado. BILLING_WEBHOOK_TOKEN protege POST /api/webhooks/cobranca
# (401 sem token; 503 enquanto o provedor não estiver conectado).
BILLING_PROVIDER=
BILLING_PROVIDER_API_KEY=
BILLING_WEBHOOK_TOKEN=

# Google Maps (somente servidor): Geocoding API + Distance Matrix API nas visitas. Sem ela, distância estimada pela cidade.
GOOGLE_MAPS_API_KEY=

# IA (Anthropic): sugestões dos agentes de automação. INTEROS_AI_MODEL é opcional (padrão claude-sonnet-5).
ANTHROPIC_API_KEY=
INTEROS_AI_MODEL=

# Microsoft SSO: não usa variável aqui; habilite o provedor Microsoft em Firebase Authentication → Sign-in method.

# Ambiente de demonstração: "true" mostra na tela de login a dica com as credenciais do usuário demo
# (hercules@intercert.com.br) e o botão para preenchê-las. Deixe vazio/false em produção.
NEXT_PUBLIC_DEMO_MODE=false
