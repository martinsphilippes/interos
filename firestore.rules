rules_version = '2';

// Ponto de partida seguro: nada é lido ou escrito sem regra explícita.
// Adicione regras por coleção conforme o domínio do Interos for definido.
// Teste localmente com `npm run firebase:emulators` antes de publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfil do próprio usuário: cada pessoa só lê o seu. Nenhuma escrita pelo cliente — papel, departamento,
    // situação e presença são gravados só pelo servidor (Admin SDK: admin/actions.ts e users/presence.ts).
    // Permitir create/update aqui deixaria qualquer conta do Auth criar ou promover o próprio documento (ex.: role "admin").
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Coleções de domínio: acesso somente pelo servidor (Admin SDK ignora as regras).
    // Listadas explicitamente quando têm dados sensíveis ou foram criadas depois da regra padrão.
    // Construtor visual de processos: definições (grafos) e execuções.
    match /process_definitions/{docId} {
      allow read, write: if false;
    }
    match /process_runs/{docId} {
      allow read, write: if false;
    }
    // Contadores transacionais de numeração (VEN, CT, PR…): escritos só pelo servidor.
    match /counters/{docId} {
      allow read, write: if false;
    }
    // Contas a pagar (títulos de comissão, bônus e lançamentos manuais): valores e credores, só pelo servidor.
    match /payables/{docId} {
      allow read, write: if false;
    }
    // Eventos de pagamento do provedor de cobrança (deduplicação da baixa automática): só pelo servidor.
    match /payment_events/{docId} {
      allow read, write: if false;
    }
    // Aditivos de contrato (antes/depois das cláusulas, assinaturas): só pelo servidor.
    match /contract_amendments/{docId} {
      allow read, write: if false;
    }
    // Fornecedores (dados bancários e PIX de credores): só pelo servidor.
    match /suppliers/{docId} {
      allow read, write: if false;
    }
    // Perfis de acesso e exceções individuais de permissão: só pelo servidor.
    match /permission_profiles/{docId} {
      allow read, write: if false;
    }
    // Links do Portal do Cliente (hash do token, cliente, validade, revogação, acessos): só pelo servidor. O portal
    // público (/portal/[token]) lê pelo Admin SDK; nenhum cliente do Firebase lê, lista ou grava esta coleção.
    match /portal_links/{docId} {
      allow read, write: if false;
    }
    // Cadastros financeiros (contas financeiras com saldo inicial, centros de custo e categorias): só pelo servidor.
    match /financial_accounts/{docId} {
      allow read, write: if false;
    }
    match /cost_centers/{docId} {
      allow read, write: if false;
    }
    match /finance_categories/{docId} {
      allow read, write: if false;
    }
    // Lançamentos de caixa (baixas com conta): só pelo servidor; nem leitura, nem criação/alteração/exclusão direta.
    match /cash_entries/{docId} {
      allow read, write: if false;
    }

    // Negação padrão para qualquer outro caminho.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
